<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F17" />
  <SolidColorBrush x:Key="PanelBrush" Color="#131A26" />
  <SolidColorBrush x:Key="PanelAltBrush" Color="#1B2434" />
  <SolidColorBrush x:Key="BorderSoftBrush" Color="#26324A" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EEF9" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A3BD" />
  <SolidColorBrush x:Key="UserBubbleBrush" Color="#1C3350" />
  <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#151D2B" />
  <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#0A0E16" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="AccentSolidBrush" Color="#22D3EE" />

  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#22D3EE" Offset="0" />
    <GradientStop Color="#6366F1" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="WindowGlowBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0E1626" Offset="0" />
    <GradientStop Color="#0B0F17" Offset="0.55" />
    <GradientStop Color="#0A1524" Offset="1" />
  </LinearGradientBrush>

</ResourceDictionary>
