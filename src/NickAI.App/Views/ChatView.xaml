<UserControl x:Class="NickAI.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NickAI.App.ViewModels"
             PreviewKeyDown="OnPreviewKeyDown">

  <UserControl.Resources>

    <DataTemplate DataType="{x:Type vm:ArtifactViewModel}">
      <Border Background="{DynamicResource PanelAltBrush}"
              BorderBrush="{DynamicResource BorderSoftBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12"
              Margin="0,6,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding TypeLabel}"
                       Foreground="{DynamicResource AccentSolidBrush}"
                       FontWeight="SemiBold"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{Binding Preview}"
                     Style="{StaticResource Muted}"
                     TextWrapping="Wrap"
                     MaxHeight="96"
                     Margin="0,6,0,0" />

          <TextBlock Text="{Binding Path}"
                     Style="{StaticResource Muted}"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Margin="0,4,0,0" />

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Open" Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}" />
            <Button Content="Open folder"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding OpenFolderCommand}"
                    Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SegmentViewModel}">
      <StackPanel Margin="0,3">
        <TextBlock Text="{Binding Text}"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsCode, Converter={StaticResource InverseBoolToVis}}" />

        <Border Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CodeBackgroundBrush}"
                CornerRadius="8"
                Padding="10">
          <StackPanel>
            <TextBlock Text="{Binding LanguageLabel}"
                       Foreground="#7C93B8"
                       FontSize="11"
                       FontFamily="Consolas"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Text, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#D7E2F5"
                     FontFamily="Consolas"
                     FontSize="12.5"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     MaxHeight="360" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MessageViewModel}">
      <Border Margin="0,6"
              Padding="14"
              CornerRadius="12"
              Background="{DynamicResource AssistantBubbleBrush}"
              BorderBrush="{DynamicResource BorderSoftBrush}"
              BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,6" />

          <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource PanelAltBrush}"
                  CornerRadius="8"
                  Padding="10"
                  Margin="0,6,0,2">
            <TextBlock Text="{Binding PlanSummary}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>

          <TextBlock Text="{Binding Text}"
                     TextWrapping="Wrap"
                     Visibility="{Binding ShowPlainText, Converter={StaticResource BoolToVis}}" />

          <ItemsControl ItemsSource="{Binding Segments}"
                        Visibility="{Binding ShowSegments, Converter={StaticResource BoolToVis}}" />

          <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,4,0,0" />

          <TextBlock Text="{Binding Error}"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0"
                     Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <!-- Empty state -->
      <StackPanel Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVis}}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  MaxWidth="640">
        <TextBlock Text="What should NICK build?"
                   Style="{StaticResource H1}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="NICK plans the request, runs it through local agents and writes real files into your artifacts folder."
                   Style="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,10,0,18" />
        <ItemsControl ItemsSource="{Binding SamplePrompts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}"
                      Style="{StaticResource GhostButton}"
                      Margin="4"
                      Command="{Binding DataContext.UsePromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Conversation -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,8,0" />
      </ScrollViewer>
    </Grid>

    <!-- Composer -->
    <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 Style="{StaticResource PromptBox}"
                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="52"
                 MaxHeight="150"
                 VerticalContentAlignment="Top" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
          <Button Content="Attach" Style="{StaticResource GhostButton}" Command="{Binding AttachCommand}" />
          <Button Content="Stop" Style="{StaticResource GhostButton}" Command="{Binding StopCommand}" Margin="8,0,0,0" />
          <Button Content="Send" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
