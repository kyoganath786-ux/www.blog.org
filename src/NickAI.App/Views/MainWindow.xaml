<Window x:Class="NickAI.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NickAI.App.ViewModels"
        xmlns:views="clr-namespace:NickAI.App.Views"
        Title="NICK AI"
        Height="840" Width="1340" MinHeight="620" MinWidth="1040"
        Background="{DynamicResource WindowGlowBrush}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
      <views:ChatView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
      <views:ProjectsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ArtifactsViewModel}">
      <views:ArtifactsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
      <views:ModelsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PermissionsViewModel}">
      <views:PermissionsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NavItem}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Glyph}" FontSize="15" Width="24" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" Margin="6,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}" />
          <TextBlock Text="NICK AI" Style="{StaticResource H1}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ComboBox Style="{StaticResource ComboBoxFlat}"
                    ItemsSource="{Binding ModelOptions}"
                    SelectedItem="{Binding SelectedModel}"
                    ToolTip="Active local model" />
          <TextBlock Text="{Binding ActiveProjectLabel}"
                     Style="{StaticResource Muted}"
                     VerticalAlignment="Center"
                     Margin="14,0" />
          <ComboBox Style="{StaticResource ComboBoxFlat}"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme}"
                    MinWidth="110"
                    Margin="0,0,12,0"
                    ToolTip="Theme" />
          <Button Content="Refresh models"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding RefreshModelsCommand}"
                  Margin="0,0,12,0" />
          <Button Content="Settings"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderSoftBrush}"
              BorderThickness="0,0,1,0"
              Padding="12">
        <DockPanel>
          <Button DockPanel.Dock="Top"
                  Content="＋  New chat"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding NewChatCommand}"
                  Margin="0,4,0,14" />

          <StackPanel DockPanel.Dock="Bottom" Margin="4,14,4,4">
            <TextBlock Text="STATUS" Style="{StaticResource Muted}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="PROJECT" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Text="{Binding ActiveProjectLabel}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>

          <ListBox Style="{StaticResource NavList}"
                   ItemContainerStyle="{StaticResource NavItem}"
                   ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNav}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
  </Grid>
</Window>
